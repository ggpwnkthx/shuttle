    "openid-client": "^6.8.8",
    "path-to-regexp": "^8.4.2",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/ws": "^8.18.2",
    "oidc-provider": "9",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
