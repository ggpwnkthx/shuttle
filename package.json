{
  "name": "shuttle",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Shuttle: an application gateway that authenticates a caller, asks an access service and forwards the request to a single upstream.",
  "scripts": {
    "dev": "bun --watch scripts/dev.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "test:unit": "bun test src",
    "test:contract": "bun test test/contract",
    "test:network": "bun test test/network",
    "test:integration": "bun test test/integration",
    "test:browser": "bun test test/browser",
    "test:load": "bun test test/load",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "architecture": "bun run scripts/architecture.ts",
    "versions": "bun run scripts/version.ts",
    "load": "bun run scripts/load.ts",
    "benchmark": "bun run scripts/benchmark.ts",
    "postgres:migrate": "bun run scripts/postgres-migrate.ts"
  },
  "dependencies": {
    "chokidar": "4.0.3",
    "cookie": "^2.0.1",
    "hono": "4.13.13",
    "ioredis": "^6.0.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "lru-cache": "11.5.3",
    "openid-client": "6.8.8",
    "path-to-regexp": "8.4.2",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "redis": "^6.3.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.5.11",
    "@types/bun": "1.4.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.2",
    "oidc-provider": "9.12.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
