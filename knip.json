{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/**/*.test.ts",
    "test/**/*.ts",
    "scripts/*.ts",
    "services/*.ts",
    "examples/**/*.ts"
  ],
  "project": [
    "src/**",
    "scripts/**",
    "services/**",
    "test/**",
    "examples/**"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "ignoreIssues": {
    "test/**": ["exports", "types"],
    "scripts/**": ["exports", "types"],
    "services/**": ["exports", "types"],
    "examples/**": ["exports", "types"],
    "src/**/*.test.ts": ["exports", "types"]
  }
}
